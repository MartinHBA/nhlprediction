{
  "routes": [
    { "route": "/power-rankings", "rewrite": "/power-rankings.html", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/power-rankings.html", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/power-rankings.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/power-rankings.css", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/app.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/i18n.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/styles.css", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/config.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/release.json", "headers": { "Cache-Control": "no-store" } },
    { "route": "/index.html", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/", "headers": { "Cache-Control": "no-cache" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": { ".svg": "image/svg+xml", ".json": "application/json" }
}
